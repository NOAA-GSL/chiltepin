# Variables consumed by docker-compose.yml.
# docker compose reads this file automatically from the compose file's directory.
# Image versions and the container-name prefix also have inline defaults there.

# Use a distinct -p project name AND CLUSTER_NAME for each concurrent cluster.
# The project name isolates networks/volumes; CLUSTER_NAME isolates container names.
COMPOSE_PROJECT_NAME=chiltepin
CLUSTER_NAME=chiltepin

# Ubuntu base version. Selects which published image variant we pull from the
# dockerspackstackslurmcluster registry (must match a published spack-stack image tag).
# Currently supported values: '26.04' or '24.04'
UBUNTU_VERSION=26.04

# Spack-stack version. Selects the spack-stack image tag suffix we pull. Bump in
# lockstep with a new spack-stack release published by the upstream base repo.
SPACK_STACK_VERSION=2.1.0

# Composite image tag produced from the above:
#   ghcr.io/noaa-gsl/dockerspackstackslurmcluster/slurm-spack-stack-<role>:ubuntu-${UBUNTU_VERSION}-spack-stack-${SPACK_STACK_VERSION}
#
# To switch versions for a single invocation without editing this file:
#   UBUNTU_VERSION=24.04 docker compose up
